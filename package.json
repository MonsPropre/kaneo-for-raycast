{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "kaneo-for-raycast",
  "title": "Kaneo",
  "description": "Quickly check and manage your Kaneo projects",
  "icon": "kaneo.png",
  "author": "Baldy",
  "contributors": [
    "jeremie_constant"
  ],
  "license": "MIT",
  "categories": [
    "Productivity",
    "Applications"
  ],
  "platforms": [
    "Windows",
    "macOS"
  ],
  "commands": [
    {
      "name": "list-projects",
      "title": "List Projects",
      "description": "List Kaneo projects",
      "mode": "view",
      "subtitle": "Kaneo"
    },
    {
      "name": "create-task",
      "title": "Create Task",
      "description": "Create a new task",
      "mode": "view",
      "subtitle": "Kaneo"
    },
    {
      "name": "notifications",
      "title": "Notifications",
      "description": "List Kaneo notifications",
      "mode": "view",
      "subtitle": "Kaneo"
    },
    {
      "name": "my-tasks",
      "title": "My Tasks",
      "description": "List tasks assigned to you",
      "mode": "view",
      "subtitle": "Kaneo"
    }
  ],
  "tools": [
    {
      "name": "list-projects-ai",
      "title": "List Projects",
      "description": "List and search Kaneo projects. Use this tool when the user asks about projects.",
      "mode": "no-view"
    },
    {
      "name": "list-tasks-ai",
      "title": "List Tasks",
      "description": "List and filter Kaneo tasks. Use this tool when the user asks about tasks, priorities, statuses, or due dates.",
      "mode": "no-view"
    },
    {
      "name": "list-notifications-ai",
      "title": "List Notifications",
      "description": "List Kaneo notifications. Use this tool when the user asks about notifications or unread activity.",
      "mode": "no-view"
    }
  ],
  "ai": {
    "instructions": "Kaneo is a task management application for projects, tasks, and notifications. Use the available Kaneo tools to answer questions about the user's data. Use the project tool for project-related requests, the task tool for task-related requests, and the notification tool for notification-related requests. Never invent project IDs, task IDs, or notification data. Use only information returned by the tools. Preserve the user's language in the final response. Keep all command names and UI labels in English. This extension is read-only for search and listing requests.",
    "evals": [
      {
        "input": "List my Kaneo projects",
        "expected": [
          {
            "callsTool": "list-projects-ai"
          }
        ]
      },
      {
        "input": "Show my tasks",
        "expected": [
          {
            "callsTool": "list-tasks-ai"
          }
        ]
      },
      {
        "input": "Show my high priority tasks",
        "expected": [
          {
            "callsTool": {
              "name": "list-tasks-ai",
              "arguments": {
                "priority": "high"
              }
            }
          }
        ]
      },
      {
        "input": "Show my notifications",
        "expected": [
          {
            "callsTool": "list-notifications-ai"
          }
        ]
      },
      {
        "input": "List my projects and tasks",
        "expected": [
          {
            "callsTool": "kaneo-ai"
          }
        ]
      }
    ]
  },
  "preferences": [
    {
      "name": "instanceUrl",
      "type": "textfield",
      "title": "API URL",
      "description": "Your instance API URL",
      "default": "https://cloud.kaneo.app",
      "required": true
    },
    {
      "name": "webInstanceUrl",
      "type": "textfield",
      "title": "Client URL",
      "description": "Your instance client URL",
      "default": "https://cloud.kaneo.app",
      "required": true
    },
    {
      "name": "apiToken",
      "type": "password",
      "title": "API Token",
      "description": "Your instance API token",
      "required": true
    },
    {
      "name": "workspaceId",
      "type": "textfield",
      "title": "Workspace ID",
      "description": "Your workspace ID",
      "required": true
    },
    {
      "name": "sort",
      "type": "dropdown",
      "title": "Sort Tasks",
      "description": "Sort tasks by priority or due date",
      "required": true,
      "default": "priority",
      "data": [
        {
          "value": "priority",
          "title": "Priority"
        },
        {
          "value": "dueDate",
          "title": "Due Date"
        }
      ]
    },
    {
      "name": "youAsAssignee",
      "type": "checkbox",
      "label": "Assigned to you",
      "description": "Display your name or \"You\" when task is assigned to you",
      "required": false,
      "default": true
    },
    {
      "name": "requestTimeout",
      "type": "dropdown",
      "title": "Request Timeout",
      "description": "Delay before timeout requests",
      "required": true,
      "default": "2500",
      "data": [
        {
          "value": "1000",
          "title": "1 Seconds"
        },
        {
          "value": "2500",
          "title": "2.5 Seconds"
        },
        {
          "value": "5000",
          "title": "5 Seconds"
        },
        {
          "value": "10000",
          "title": "10 Seconds"
        },
        {
          "value": "30000",
          "title": "30 Seconds"
        }
      ]
    }
  ],
  "keywords": [
    "kaneo",
    "task",
    "productivity"
  ],
  "dependencies": {
    "@raycast/api": "^1.104.22",
    "@raycast/utils": "^2.2.7",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1"
  }
}